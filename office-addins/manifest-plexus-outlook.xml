<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp"
>
  <Id>2F1EF187-C599-427F-9176-D68EF490D972</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>Plexus</ProviderName>
  <DefaultLocale>en-AU</DefaultLocale>
  <DisplayName DefaultValue="Plexus"/>
  <Description DefaultValue="Access the full Plexus Gateway application from within Outlook."/>
  <IconUrl DefaultValue="https://outlook.app.legalgateway.com.au/assets/plexus-64x64.png" />
  <HighResolutionIconUrl DefaultValue="https://outlook.app.legalgateway.com.au/assets/plexus-128x128.png"/>
  <SupportUrl DefaultValue="https://help.legalgateway.com.au"/>
  <AppDomains>
    <AppDomain>https://app.legalgateway.com.au</AppDomain>
    <AppDomain>https://plxs.au.auth0.com</AppDomain>
    <AppDomain>https://graph.microsoft.com</AppDomain>
    <AppDomain>https://app.plexuspromotions.com.au</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://app.legalgateway.com.au/gateway/documents/?office_addin=true"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="msgReadOpenPaneButton">
                    <Label resid="TaskpaneButton.Label" />
                    <Supertip>
                      <Title resid="TaskpaneButton.Label" />
                      <Description resid="TaskpaneButton.Tooltip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="AttachGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="AttachToEmailButton">
                    <Label resid="AttachToEmailButton.Label"/>
                    <Supertip>
                      <Title resid="AttachToEmailButton.Label"/>
                      <Description resid="AttachToEmailButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://outlook.app.legalgateway.com.au/assets/plexus-16x16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://outlook.app.legalgateway.com.au/assets/plexus-32x32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://outlook.app.legalgateway.com.au/assets/plexus-80x80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://app.legalgateway.com.au/gateway/documents/?office_addin=true" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Plexus" />
          <bt:String id="TaskpaneButton.Label" DefaultValue="Open Plexus" />
          <bt:String id="AttachToEmailButton.Label" DefaultValue="Attach file from Plexus" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open and use Plexus from Microsoft Outlook." />
          <bt:String id="AttachToEmailButton.Tooltip" DefaultValue="Attach files to this email from the Plexus Document details page." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>

